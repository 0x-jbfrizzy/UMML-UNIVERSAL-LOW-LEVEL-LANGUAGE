# Autonomous Drone Flight Controller
pin airspeed_sensor input 16
pin gps_signal_lost input 1
pin elevator_servo output 16
pin motor_thrust output 16

make a state_machine named flight_control with states CRUISE, CLIMB, DIVE, RECOVER

# Absolute Safety Overrides
if airspeed_sensor < 500 force flight_control to RECOVER
if gps_signal_lost force flight_control to RECOVER

start machine
